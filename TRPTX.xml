<variable>
    <name>trptx</name>
    <equation_type>Behavioral</equation_type>
    <sector>Government</sector>
    <definition>Average tax rate for personal income tax, trend, policy setting</definition>
    <standard_equation>
      <eviews_equation>trptx - trptx_aerr = y_trptx(1)*(1-y_trptx(2)) + y_trptx(2)*trptx(-1)
                                            + y_trptx(3)*xgap2 + y_trptx(4)*xgap2(-1) 
                                            + y_trptx(5)*picxfe
                                            + (rg10 + y_trptx(6)) * (gfdbtnp(-1)/xgdpn(-1) - gfdrt(-1))
                                            + y_trptx(7)*((gfdbtnp(-1)/xgdpn(-1)) - gfdrt(-1) - (gfdbtnp(-2)/xgdpn(-2) - gfdrt(-2)))</eviews_equation>
      <python_equation>trptx - trptx_aerr = y_trptx_1*(1-y_trptx_2) + y_trptx_2*trptx(-1)
                                              + y_trptx_3*xgap2 + y_trptx_4*xgap2(-1)
                                              + y_trptx_5*picxfe
                                              + (rg10 + y_trptx_6) * (gfdbtnp(-1)/xgdpn(-1) - gfdrt(-1))
                                              + (y_trptx_7)*((gfdbtnp(-1)/xgdpn(-1)) - gfdrt(-1) - (gfdbtnp(-2)/xgdpn(-2) - gfdrt(-2)))</python_equation>
      <coeff>
        <cf_name>y_trptx(1)</cf_name>
        <cf_value>0.15</cf_value>  <!-- Base tax rate -->
      </coeff>
      <coeff>
        <cf_name>y_trptx(2)</cf_name>
        <cf_value>0.8</cf_value>   <!-- Persistence parameter -->
      </coeff>
      <coeff>
        <cf_name>y_trptx(3)</cf_name>
        <cf_value>0.08</cf_value>  <!-- Output gap reaction (procyclical) -->
      </coeff>
      <coeff>
        <cf_name>y_trptx(4)</cf_name>
        <cf_value>0.05</cf_value>  <!-- Lagged output gap reaction -->
      </coeff>
      <coeff>
        <cf_name>y_trptx(5)</cf_name>
        <cf_value>0.03</cf_value>  <!-- Inflation reaction -->
      </coeff>
      <coeff>
        <cf_name>y_trptx(6)</cf_name>
        <cf_value>0.1</cf_value>  <!-- Target debt response (a > r) -->
      </coeff>
      <coeff>
        <cf_name>y_trptx(7)</cf_name>
        <cf_value>0.0</cf_value>   <!-- Debt deviation response (b = 0) -->
      </coeff>
      <rhs_eq_var>trptx</rhs_eq_var>
      <rhs_eq_var>xgap2</rhs_eq_var>
      <rhs_eq_var>picxfe</rhs_eq_var>
      <rhs_eq_var>gfdrt</rhs_eq_var>
      <rhs_eq_var>gfdbtnp</rhs_eq_var>
      <rhs_eq_var>rfrs10</rhs_eq_var>
      <rhs_eq_var>xgdpn</rhs_eq_var>
    </standard_equation>
    <stochastic_type>NO</stochastic_type>
  </variable>