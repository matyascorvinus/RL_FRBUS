
  <variable>
    <name>trptx</name>
    <equation_type>Behavioral</equation_type>
    <sector>Government</sector>
    <definition>Federal Government budget surplus, residual - FTPL enhanced</definition>
    <description>Enhanced for active fiscal policy regime with economic reactions but no automatic debt stabilization</description>
    <standard_equation>
      <eviews_equation>trptx - trptx_aerr = y_trptx(1)*(1-y_trptx(2)) + y_trptx(2)*trptx(-1)
                                             + y_trptx(3)*xgap2 + y_trptx(4)*xgap2(-1) 
                                             + y_trptx(6)*picxfe</eviews_equation>
      <python_equation>trptx - trptx_aerr = y_trptx_1*(1-y_trptx_2) + y_trptx_2*trptx(-1)
                                              + y_trptx_3*xgap2 + y_trptx_4*xgap2(-1)
                                              + y_trptx_6*picxfe</python_equation>
      <coeff>
        <cf_name>y_trptx(1)</cf_name>
        <cf_value>0.02</cf_value>  <!-- Reduced intercept -->
      </coeff>
      <coeff>
        <cf_name>y_trptx(2)</cf_name>
        <cf_value>0.85</cf_value>  <!-- Persistence parameter -->
      </coeff>
      <coeff>
        <cf_name>y_trptx(3)</cf_name>
        <cf_value>1.2</cf_value>   <!-- Output gap reaction (procyclical) -->
      </coeff>
      <coeff>
        <cf_name>y_trptx(4)</cf_name>
        <cf_value>0.8</cf_value>   <!-- Lagged output gap reaction -->
      </coeff>
      <coeff>
        <cf_name>y_trptx(5)</cf_name>
        <cf_value>0.6</cf_value>   <!-- Unemployment gap reaction -->
      </coeff>
      <coeff>
        <cf_name>y_trptx(6)</cf_name>
        <cf_value>0.3</cf_value>   <!-- Inflation reaction -->
      </coeff>
      <rhs_eq_var>trptx</rhs_eq_var>
      <rhs_eq_var>xgap2</rhs_eq_var>
      <rhs_eq_var>lur</rhs_eq_var>
      <rhs_eq_var>lurnat</rhs_eq_var>
      <rhs_eq_var>picxfe</rhs_eq_var>
    </standard_equation>
    <stochastic_type>NO</stochastic_type>
  </variable>