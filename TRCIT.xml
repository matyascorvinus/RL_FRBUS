<variable>
    <name>trcit</name>
    <equation_type>Behavioral</equation_type>
    <sector>Government</sector>
    <definition>Government corporate income tax rate, trend</definition>
    <standard_equation>
      <eviews_equation>trcit - trcit_aerr = y_trcit(1)*(1-y_trcit(2)) + y_trcit(2)*trcit(-1)
                                            + y_trcit(3)*xgap2 + y_trcit(4)*xgap2(-1) 
                                            + y_trcit(5)*picxfe
                                            + (rfrs10 + y_trcit(6)) * (gfdbtnp(-1)/xgdpn(-1) - gfdrt(-1))
                                            + y_trcit(7)*((gfdbtnp(-1)/xgdpn(-1)) - gfdrt(-1) - (gfdbtnp(-2)/xgdpn(-2) - gfdrt(-2)))</eviews_equation>
      <python_equation>trcit - trcit_aerr = y_trcit_1*(1-y_trcit_2) + y_trcit_2*trcit(-1)
                                              + y_trcit_3*xgap2 + y_trcit_4*xgap2(-1)
                                              + y_trcit_5*picxfe
                                              + (rfrs10 + y_trcit_6) * (gfdbtnp(-1)/xgdpn(-1) - gfdrt(-1))
                                              + y_trcit_7*((gfdbtnp(-1)/xgdpn(-1)) - gfdrt(-1) - (gfdbtnp(-2)/xgdpn(-2) - gfdrt(-2)))</python_equation>
      <coeff>
        <cf_name>y_trcit(1)</cf_name>
        <cf_value>0.25</cf_value>  <!-- Base tax rate -->
      </coeff>
      <coeff>
        <cf_name>y_trcit(2)</cf_name>
        <cf_value>0.8</cf_value>   <!-- Persistence parameter -->
      </coeff>
      <coeff>
        <cf_name>y_trcit(3)</cf_name>
        <cf_value>0.05</cf_value>  <!-- Output gap reaction (procyclical) -->
      </coeff>
      <coeff>
        <cf_name>y_trcit(4)</cf_name>
        <cf_value>0.03</cf_value>  <!-- Lagged output gap reaction -->
      </coeff>
      <coeff>
        <cf_name>y_trcit(5)</cf_name>
        <cf_value>0.02</cf_value>  <!-- Inflation reaction -->
      </coeff>
      <coeff>
        <cf_name>y_trcit(6)</cf_name>
        <cf_value>0.1</cf_value>  <!-- Target debt response (a > r, Cochrane's condition) -->
      </coeff>
      <coeff>
        <cf_name>y_trcit(7)</cf_name>
        <cf_value>0.0</cf_value>   <!-- Debt deviation response (b = 0, active fiscal) -->
      </coeff>
      <rhs_eq_var>trcit</rhs_eq_var>
      <rhs_eq_var>xgap2</rhs_eq_var>
      <rhs_eq_var>picxfe</rhs_eq_var>
      <rhs_eq_var>gfdrt</rhs_eq_var>
      <rhs_eq_var>gfdbtnp</rhs_eq_var>
      <rhs_eq_var>xgdpn</rhs_eq_var>
      <rhs_eq_var>rfrs10</rhs_eq_var>
    </standard_equation>
    <stochastic_type>NO</stochastic_type>
  </variable>